---
import Wordmark from '~/components/Wordmark.astro';
import { SERVICES, SPECIALIST_SERVICES, ADDITIONAL_SERVICES } from '~/data/site';

const primary = SERVICES.filter((s) => s.primary);
const dropdown = [
  ...SERVICES.filter((s) => !s.primary),
  ...SPECIALIST_SERVICES,
  ...ADDITIONAL_SERVICES,
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const dropdownCurrent = dropdown.some((s) => isCurrent(`/services/${s.slug}`));

const linkBase =
  'nav-label text-ivory/85 transition-colors hover:text-gold aria-[current=page]:text-gold';
---

<header class="grained relative z-50 bg-burgundy text-ivory">
  {/* Full-strength at 1px reads as foil edging; faded, it reads as brown. */}
  <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-px bg-rule-gold"></span>

  <div class="mx-auto max-w-7xl px-6">
    <div class="flex items-center justify-between gap-6 py-5">
      <a href="/" aria-label="TOME Publishers — home" class="shrink-0">
        <Wordmark tone="dark" full={false} class="h-9 w-auto" />
      </a>

      <nav aria-label="Primary" class="hidden xl:block">
        <ul class="flex items-center gap-5">
          {
            primary.map((service) => (
              <li>
                <a
                  href={`/services/${service.slug}`}
                  aria-current={isCurrent(`/services/${service.slug}`) ? 'page' : undefined}
                  class={linkBase}
                >
                  {service.title.replace(' & Proofreading', '').replace('Book ', '')}
                </a>
              </li>
            ))
          }

          <li class="relative" data-dropdown>
            <button
              type="button"
              data-dropdown-trigger
              aria-expanded="false"
              aria-controls="services-menu"
              class={`${linkBase} flex items-center gap-1.5 ${dropdownCurrent ? 'text-gold' : ''}`}
            >
              Other Services
              <span
                aria-hidden="true"
                class="text-[0.6em] transition-transform duration-200"
                data-dropdown-caret>&#9660;</span
              >
            </button>

            <div
              id="services-menu"
              data-dropdown-panel
              class="invisible absolute right-0 top-full z-50 w-[34rem] pt-4 opacity-0 transition-opacity duration-200"
            >
              <ul
                class="grid grid-cols-2 gap-x-6 gap-y-1 border border-rule-gold/70 bg-burgundy p-6 shadow-2xl"
              >
                {
                  dropdown.map((service) => (
                    <li>
                      <a
                        href={`/services/${service.slug}`}
                        aria-current={isCurrent(`/services/${service.slug}`) ? 'page' : undefined}
                        class="editorial block py-1.5 text-small text-ivory/75 transition-colors hover:text-gold aria-[current=page]:text-gold"
                      >
                        {service.title}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </li>

          <li>
            <a href="/books" aria-current={isCurrent('/books') ? 'page' : undefined} class={linkBase}>
              Books
            </a>
          </li>
          <li>
            <a href="/about" aria-current={isCurrent('/about') ? 'page' : undefined} class={linkBase}>
              About
            </a>
          </li>
          <li>
            <a
              href="/inquiry"
              class="nav-label lift inline-block bg-gold px-5 py-3 text-burgundy hover:bg-ivory"
            >
              Get Started
            </a>
          </li>
        </ul>
      </nav>

      <details class="relative xl:hidden">
        <summary
          class="nav-label cursor-pointer list-none py-2 text-gold [&::-webkit-details-marker]:hidden"
        >
          Menu
        </summary>
        <nav
          aria-label="Primary"
          class="absolute right-0 top-full z-50 mt-2 max-h-[70vh] w-72 overflow-y-auto border border-rule-gold/80 bg-burgundy p-6 shadow-2xl"
        >
          {/*
            Services are nested behind their own disclosure so the menu opens
            as six items rather than a twenty-three item wall. Every target is
            padded to ~44px for touch.
          */}
          <details class="group/svc border-b border-rule-gold/70 pb-2">
            <summary
              class="nav-label flex cursor-pointer list-none items-center justify-between py-3 text-ivory/85 hover:text-gold [&::-webkit-details-marker]:hidden"
            >
              Services
              <span
                aria-hidden="true"
                class="text-[0.6em] transition-transform group-open/svc:rotate-180">&#9660;</span
              >
            </summary>
            <ul class="mb-2">
              {
                [...SERVICES, ...SPECIALIST_SERVICES, ...ADDITIONAL_SERVICES].map((service) => (
                  <li>
                    <a
                      href={`/services/${service.slug}`}
                      class="editorial block py-3 pl-3 text-small text-ivory/75 hover:text-gold"
                    >
                      {service.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>

          <div class="mt-2">
            <a href="/books" class="nav-label block py-3 text-ivory/85 hover:text-gold">Books</a>
            <a href="/authors" class="nav-label block py-3 text-ivory/85 hover:text-gold">Authors</a>
            <a href="/journal" class="nav-label block py-3 text-ivory/85 hover:text-gold">Journal</a>
            <a href="/about" class="nav-label block py-3 text-ivory/85 hover:text-gold">About</a>
            <a href="/contact" class="nav-label block py-3 text-ivory/85 hover:text-gold">Contact</a>
            <a
              href="/inquiry"
              class="nav-label mt-3 block bg-gold px-5 py-3.5 text-center text-burgundy"
            >
              Get Started
            </a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  /**
   * The dropdown was previously hover-only, with a button that did nothing on
   * click and an aria-expanded that never changed. This drives the real state,
   * so pointer, keyboard and touch all work and screen readers are told the
   * truth.
   */
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
    const panel = root.querySelector<HTMLElement>('[data-dropdown-panel]');
    const caret = root.querySelector<HTMLElement>('[data-dropdown-caret]');
    if (!trigger || !panel) return;

    let open = false;
    let hoverTimer: number | undefined;

    const setOpen = (next: boolean) => {
      open = next;
      trigger.setAttribute('aria-expanded', String(next));
      panel.classList.toggle('invisible', !next);
      panel.classList.toggle('opacity-0', !next);
      if (caret) caret.style.transform = next ? 'rotate(180deg)' : '';
    };

    trigger.addEventListener('click', () => setOpen(!open));

    // Hover is a convenience for pointer users, not the source of truth.
    root.addEventListener('mouseenter', () => {
      window.clearTimeout(hoverTimer);
      setOpen(true);
    });
    root.addEventListener('mouseleave', () => {
      hoverTimer = window.setTimeout(() => setOpen(false), 120);
    });

    // Keyboard: focus leaving the group closes it, Escape returns focus.
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) {
        setOpen(false);
        trigger.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (open && !root.contains(event.target as Node)) setOpen(false);
    });
  });
</script>
