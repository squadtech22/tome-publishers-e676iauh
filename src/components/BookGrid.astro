---
import type { CollectionEntry } from 'astro:content';
import BookCover from '~/components/BookCover.astro';
import { formatYear } from '~/lib/content';

interface Props {
  books: CollectionEntry<'books'>[];
}
const { books } = Astro.props;
---

<ul class="grid grid-cols-2 gap-x-8 gap-y-14 md:grid-cols-3 lg:grid-cols-4">
  {books.map((book) => (
    <li>
      <a href={`/books/${book.id}`} class="group block">
        <div class="overflow-hidden">
          <BookCover
            title={book.data.title}
            author={book.data.author}
            cover={book.data.cover}
            class="transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </div>
        <h3 class="mt-5 text-h4 group-hover:text-burgundy/70 transition-colors">
          {book.data.title}
        </h3>
        <p class="editorial mt-1 text-charcoal/70">{book.data.author}</p>
        <p class="metadata mt-2 text-label text-charcoal/50 uppercase tracking-wider">
          {book.data.genre} &middot; {formatYear(book.data.pubDate)}
        </p>
      </a>
    </li>
  ))}
</ul>
