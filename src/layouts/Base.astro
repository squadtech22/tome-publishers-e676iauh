---
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource-variable/inter/wght.css';
import '~/styles/tokens.css';

import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative OG image path. */
  image?: string;
}

const {
  title,
  description = 'From ghostwriting and editorial development to publishing, design, printing and marketing, TOME helps authors bring their books to life.',
  image = '/og-default.png',
} = Astro.props;

const pageTitle = title === 'home' ? 'TOME Publishers' : `${title} — TOME Publishers`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#2b0f14" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'TOME Publishers',
        url: 'https://tomepublishers.com',
        email: 'hello@tomepublishers.com',
        description,
      })}
    />
    <slot name="head" />

    <script is:inline>
      // Set before first paint so `.reveal` elements are only hidden when
      // JavaScript can reveal them again. No-JS visitors see everything.
      document.documentElement.classList.add('js');

      // Watchdog. Hiding content up front is only safe if something is
      // guaranteed to bring it back: if the reveal module fails to load, or
      // runs somewhere its observer never fires, show everything rather than
      // stranding the visitor on a blank page.
      window.__revealWatchdog = window.setTimeout(function () {
        var els = document.querySelectorAll('.reveal');
        for (var i = 0; i < els.length; i++) els[i].classList.add('is-visible');
      }, 1600);
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-3 focus:left-3 focus:bg-burgundy focus:text-ivory focus:px-4 focus:py-2"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <!-- Scroll to Top Button -->
    <button
      id="scrollToTopBtn"
      class="fixed bottom-24 right-7 z-40 flex items-center justify-center w-12 h-12 bg-white text-gray-800 rounded-full shadow-[0_4px_14px_rgba(0,0,0,0.15)] hover:bg-gray-50 hover:scale-110 transition-all duration-300 opacity-0 pointer-events-none translate-y-4"
      aria-label="Scroll to top"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </button>

    <a
      href="https://api.whatsapp.com/send/?phone=14029010977&text&type=phone_number&app_absent=0"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-6 right-7 z-50 flex items-center justify-center w-12 h-12 bg-[#25D366] text-white rounded-full shadow-lg hover:bg-[#20b858] hover:scale-110 transition-all duration-300"
      aria-label="Chat on WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
      </svg>
    </a>

    <script>
      // Scroll to top functionality
      const scrollToTopBtn = document.getElementById('scrollToTopBtn');
      let scrollTimeout: number | undefined;

      if (scrollToTopBtn) {
        window.addEventListener('scroll', () => {
          clearTimeout(scrollTimeout);

          if (window.scrollY > 200) {
            scrollToTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
            scrollToTopBtn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
            
            scrollTimeout = window.setTimeout(() => {
              scrollToTopBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
              scrollToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
            }, 2500);
          } else {
            scrollToTopBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
            scrollToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
          }
        }, { passive: true });

        scrollToTopBtn.addEventListener('mouseenter', () => clearTimeout(scrollTimeout));
        
        scrollToTopBtn.addEventListener('mouseleave', () => {
          if (window.scrollY > 200) {
            scrollTimeout = window.setTimeout(() => {
              scrollToTopBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
              scrollToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
            }, 2500);
          }
        });

        scrollToTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // The watchdog in <head> is the safety net; this module has taken over.
      clearTimeout((window as { __revealWatchdog?: number }).__revealWatchdog);

      const reveals = document.querySelectorAll<HTMLElement>('.reveal');

      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      const showAll = () => reveals.forEach((el) => el.classList.add('is-visible'));

      if (prefersReducedMotion || !('IntersectionObserver' in window)) {
        showAll();
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              // One-shot: never animate the same element twice.
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );

        reveals.forEach((el) => observer.observe(el));

        // Anything already in view must not wait for a scroll. Measured
        // synchronously rather than inside requestAnimationFrame, which never
        // fires in a background or non-composited tab and would otherwise
        // leave above-the-fold content hidden.
        reveals.forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) {
            el.classList.add('is-visible');
            observer.unobserve(el);
          }
        });
      }
    </script>
  </body>
</html>
