---
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource-variable/inter/wght.css';
import '~/styles/tokens.css';

import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative OG image path. */
  image?: string;
}

const {
  title,
  description = 'From ghostwriting and editorial development to publishing, design, printing and marketing, TOME helps authors bring their books to life.',
  image = '/og-default.png',
} = Astro.props;

const pageTitle = title === 'home' ? 'TOME Publishers' : `${title} — TOME Publishers`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#2b0f14" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'TOME Publishers',
        url: 'https://tomepublishers.com',
        email: 'hello@tomepublishers.com',
        description,
      })}
    />
    <slot name="head" />

    <script is:inline>
      // Set before first paint so `.reveal` elements are only hidden when
      // JavaScript can reveal them again. No-JS visitors see everything.
      document.documentElement.classList.add('js');

      // Watchdog. Hiding content up front is only safe if something is
      // guaranteed to bring it back: if the reveal module fails to load, or
      // runs somewhere its observer never fires, show everything rather than
      // stranding the visitor on a blank page.
      window.__revealWatchdog = window.setTimeout(function () {
        var els = document.querySelectorAll('.reveal');
        for (var i = 0; i < els.length; i++) els[i].classList.add('is-visible');
      }, 1600);
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-3 focus:left-3 focus:bg-burgundy focus:text-ivory focus:px-4 focus:py-2"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      // The watchdog in <head> is the safety net; this module has taken over.
      clearTimeout((window as { __revealWatchdog?: number }).__revealWatchdog);

      const reveals = document.querySelectorAll<HTMLElement>('.reveal');

      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      const showAll = () => reveals.forEach((el) => el.classList.add('is-visible'));

      if (prefersReducedMotion || !('IntersectionObserver' in window)) {
        showAll();
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              // One-shot: never animate the same element twice.
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );

        reveals.forEach((el) => observer.observe(el));

        // Anything already in view must not wait for a scroll. Measured
        // synchronously rather than inside requestAnimationFrame, which never
        // fires in a background or non-composited tab and would otherwise
        // leave above-the-fold content hidden.
        reveals.forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) {
            el.classList.add('is-visible');
            observer.unobserve(el);
          }
        });
      }
    </script>
  </body>
</html>
