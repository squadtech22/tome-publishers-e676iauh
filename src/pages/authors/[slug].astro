---
import type { GetStaticPaths } from 'astro';
import Base from '~/layouts/Base.astro';
import BookGrid from '~/components/BookGrid.astro';
import AuthorPortrait from '~/components/AuthorPortrait.astro';
import { getAuthors, type AuthorSummary } from '~/lib/content';

export const getStaticPaths: GetStaticPaths = async () => {
  const authors = await getAuthors();

  return authors.map((author) => ({
    params: { slug: author.slug },
    props: { author },
  }));
};

interface Props {
  author: AuthorSummary;
}

const { author } = Astro.props;
const profile = author.profile;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  ...(profile?.data.bio ? { description: profile.data.bio } : {}),
  ...(profile?.data.role ? { jobTitle: profile.data.role } : {}),
  worksFor: { '@type': 'Organization', name: 'TOME Publishers' },
};
---

<Base
  title={author.name}
  description={profile?.data.bio ?? `Books by ${author.name}, published by TOME Publishers.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="grained bg-burgundy text-ivory">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <nav aria-label="Breadcrumb" class="label mb-10 text-rule-gold">
        <a href="/authors" class="link-sweep hover:text-gold">Authors</a>
      </nav>

      <div class="reveal flex flex-col gap-8 sm:flex-row sm:items-start sm:gap-10">
        <AuthorPortrait
          name={author.name}
          portrait={profile?.data.portrait}
          class="w-32 shrink-0 border border-rule-gold/70 sm:w-40"
        />

        <div>
          <h1 class="text-ivory">{author.name}</h1>

          {
            (profile?.data.role || profile?.data.location) && (
              <p class="metadata mt-4 text-label uppercase tracking-wider text-rule-gold">
                {[profile?.data.role, profile?.data.location].filter(Boolean).join(' · ')}
              </p>
            )
          }

          {
            profile?.data.bio && (
              <p class="editorial mt-6 text-h4 text-ivory/80">{profile.data.bio}</p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="text-h3">
      {author.books.length === 1 ? 'The book' : 'The books'}
    </h2>
    <div class="mt-10">
      <BookGrid books={author.books} />
    </div>
  </div>
</Base>
