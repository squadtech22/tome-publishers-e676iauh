---
import Base from '~/layouts/Base.astro';
import AuthorPortrait from '~/components/AuthorPortrait.astro';
import { getAuthors } from '~/lib/content';

const authors = await getAuthors();
---

<Base
  title="Authors"
  description="The writers published by TOME — novelists, poets, memoirists and journalists we are proud to have on the list."
>
  <section class="grained bg-burgundy text-ivory">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="label text-rule-gold mb-5">The List</p>
      <h1 class="text-ivory">Authors</h1>
      <p class="editorial mt-6 max-w-xl text-ivory/75">
        We publish few books a year, deliberately. These are the writers behind them.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-6 py-16">
    <ul class="grid gap-x-12 gap-y-14 sm:grid-cols-2">
      {
        authors.map((author, i) => (
          <li class="reveal" style={`--reveal-delay:${i % 2}`}>
            <a href={`/authors/${author.slug}`} class="group flex gap-6">
              <AuthorPortrait
                name={author.name}
                portrait={author.profile?.data.portrait}
                class="cover-hover w-24 shrink-0 sm:w-28"
              />

              <div class="min-w-0">
                <h2 class="text-h4 transition-colors group-hover:text-burgundy/70">
                  {author.name}
                </h2>

                {author.profile?.data.location && (
                  <p class="metadata mt-1.5 text-label uppercase tracking-wider text-charcoal/50">
                    {author.profile.data.location}
                  </p>
                )}

                {author.profile?.data.bio && (
                  <p class="editorial mt-3 text-charcoal/75">{author.profile.data.bio}</p>
                )}

                <p class="metadata mt-3 text-small text-charcoal/55">
                  {author.books.length} {author.books.length === 1 ? 'title' : 'titles'} with TOME
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
