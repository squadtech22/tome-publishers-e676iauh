---
import Base from '~/layouts/Base.astro';
---

<Base title="Thank You" description="Your inquiry has reached TOME Publishers.">
  <section class="grained bg-burgundy text-ivory">
    <div class="mx-auto max-w-2xl px-6 py-28 text-center">
      <p class="label text-rule-gold mb-6">Received</p>
      <h1 class="text-ivory">Thank you.</h1>

      <p class="editorial mt-8 text-h4 text-gold italic">
        Every great book begins with an idea.
      </p>

      <p class="mt-8 text-ivory/75">
        A member of our editorial team will read your inquiry properly &mdash; not
        skim it &mdash; and reply within two business days. A confirmation is on its
        way to your inbox.
      </p>

      <div class="mt-12 flex flex-wrap justify-center gap-4">
        <a
          href="/books"
          class="label border border-rule-gold px-8 py-4 text-gold hover:bg-rule-gold/10 transition-colors"
        >
          Browse the Catalog
        </a>
        <a href="/" class="label px-8 py-4 text-ivory/70 hover:text-gold transition-colors">
          Back Home
        </a>
      </div>
    </div>
  </section>
</Base>
