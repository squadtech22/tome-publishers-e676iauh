---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import BookGrid from '~/components/BookGrid.astro';
import Ornament from '~/components/Ornament.astro';
import heroSpines from '~/assets/generated/hero-spines.png';
import { getBooks, getPosts, getAuthors, formatDate } from '~/lib/content';

const [books, posts, authors] = await Promise.all([getBooks(), getPosts(), getAuthors()]);

// Fall back to the most recent titles if nothing is flagged as featured.
const featuredBooks = books.filter((b) => b.data.featured);
const shelf = (featuredBooks.length > 0 ? featuredBooks : books).slice(0, 4);
const latestPosts = posts.slice(0, 3);

const pillars = [
  {
    n: '01',
    title: 'Publishing',
    body: 'Ghostwriting, editorial development, and a route to print that treats your manuscript as literature rather than inventory.',
  },
  {
    n: '02',
    title: 'Design',
    body: 'Covers, interiors, and typesetting drawn with the same care as the words they carry.',
  },
  {
    n: '03',
    title: 'Marketing',
    body: 'Positioning and campaigns that put finished books in front of the readers most likely to love them.',
  },
];

const stats = [
  { figure: String(books.length), label: 'Titles in print' },
  { figure: String(authors.length), label: 'Authors on the list' },
  { figure: '6', label: 'Books taken a year' },
  { figure: '2', label: 'Days to a reply' },
];

const processPreview = [
  ['01', 'The reading', 'An editor reads your manuscript properly and writes back honestly. No charge, no obligation.'],
  ['02', 'The plan', 'We scope exactly what the book needs, in writing, before anything begins.'],
  ['03', 'The work', 'Editorial, design and launch — with your approval at every stage.'],
];

const testimonials = [
  {
    quote:
      'They told me the middle third was not working, and then spent four months helping me fix it. Nobody else had been willing to say the first part.',
    name: 'Margery Ash',
    book: 'What the Orchard Knew',
  },
  {
    quote:
      'I came in expecting a production service and got an argument about my own book instead. It is a much better book for it.',
    name: 'Daniel Vaszquez',
    book: 'The Quiet Ledger',
  },
];
---

<Base title="home">
  <!-- Hero -->
  <section class="grained relative overflow-hidden bg-burgundy text-ivory">
    <div class="mx-auto grid max-w-6xl gap-16 px-6 py-24 md:py-32 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div class="reveal">
        <p class="label text-rule-gold">Publishing &middot; Design &middot; Marketing</p>
        <Ornament tone="dark" class="mt-5 !w-[120px] !justify-start" />

        <h1 class="mt-8 text-ivory">
          Your Story Deserves a <span class="text-gold">TOME</span>.
        </h1>

        <p class="editorial mt-8 max-w-xl text-h4 italic text-gold/90">
          Every great book begins with an idea.
        </p>

        <p class="mt-6 max-w-xl text-ivory/75">
          From ghostwriting and editorial development to publishing, design, printing
          and marketing, TOME helps authors bring their books to life.
        </p>

        <div class="mt-12 flex flex-wrap gap-4">
          <a
            href="/inquiry"
            class="label lift bg-gold px-8 py-4 text-burgundy hover:bg-ivory"
          >
            Start Your Book
          </a>
          <a
            href="/books"
            class="label lift border border-rule-gold px-8 py-4 text-gold hover:bg-rule-gold/10"
          >
            Browse the Catalog
          </a>
        </div>
      </div>

      <div class="reveal hidden lg:block" style="--reveal-delay:2">
        <div class="relative">
          <Image
            src={heroSpines}
            alt="A shelf of clothbound books in burgundy and charcoal, tooled with gold bands"
            widths={[440, 660, 900]}
            sizes="(max-width: 1024px) 0px, 440px"
            class="w-full shadow-[0_30px_60px_-25px_rgb(0_0_0/0.7)]"
            loading="eager"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 border border-rule-gold/30"
          ></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="grained bg-charcoal text-ivory">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <dl class="grid grid-cols-2 gap-10 text-center sm:grid-cols-4">
        {
          stats.map((stat, i) => (
            /* column-reverse puts the figure above the label visually while
               keeping dt-then-dd order in the DOM for assistive tech. */
            <div class="reveal flex flex-col-reverse gap-3" style={`--reveal-delay:${i}`}>
              <dt class="label text-ivory/60">{stat.label}</dt>
              <dd class="metadata text-h2 leading-none text-gold">{stat.figure}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Pillars -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <div class="grid gap-12 md:grid-cols-3">
      {
        pillars.map(({ n, title, body }, i) => (
          <article class="reveal" style={`--reveal-delay:${i}`}>
            <p class="metadata text-h2 leading-none text-rule-gold">{n}</p>
            <div class="mt-4 h-px w-12 bg-rule-gold" />
            <h2 class="mt-6 text-h3">{title}</h2>
            <p class="editorial mt-4 text-charcoal/80">{body}</p>
          </article>
        ))
      }
    </div>

    <div class="reveal">
      <a
        href="/services"
        class="label lift mt-14 inline-block border border-burgundy px-8 py-4 text-burgundy hover:bg-burgundy hover:text-ivory"
      >
        All Services
      </a>
    </div>
  </section>

  <!-- Featured books -->
  {
    shelf.length > 0 && (
      <section class="bg-charcoal/[0.03]">
        <div class="mx-auto max-w-6xl px-6 py-24">
          <div class="reveal flex flex-wrap items-baseline justify-between gap-4">
            <h2 class="text-h2">From the catalog</h2>
            <a href="/books" class="label group text-burgundy">
              <span class="link-sweep">All books</span>
              <span class="nudge ml-1" aria-hidden="true">
                &rarr;
              </span>
            </a>
          </div>

          <div class="mt-14">
            <BookGrid books={shelf} />
          </div>
        </div>
      </section>
    )
  }

  <!-- Process preview -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <div class="reveal">
      <h2 class="text-h2">How it works</h2>
      <p class="editorial mt-5 max-w-xl text-charcoal/75">
        Six stages, nine to fourteen months. Here are the first three.
      </p>
    </div>

    <ol class="mt-14 grid gap-12 md:grid-cols-3">
      {
        processPreview.map(([n, title, body], i) => (
          <li class="reveal" style={`--reveal-delay:${i}`}>
            <p class="metadata text-label uppercase tracking-widest text-rule-gold">{n}</p>
            <h3 class="mt-3 text-h4">{title}</h3>
            <p class="editorial mt-3 text-charcoal/75">{body}</p>
          </li>
        ))
      }
    </ol>

    <div class="reveal">
      <a
        href="/process"
        class="label lift mt-14 inline-block border border-burgundy px-8 py-4 text-burgundy hover:bg-burgundy hover:text-ivory"
      >
        The Full Process
      </a>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="grained bg-burgundy text-ivory">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <Ornament tone="dark" class="reveal mx-auto" />

      <div class="mt-16 grid gap-14 md:grid-cols-2">
        {
          testimonials.map((testimonial, i) => (
            <figure class="reveal" style={`--reveal-delay:${i}`}>
              <blockquote class="editorial border-l-2 border-rule-gold pl-6 text-h4 italic text-ivory/90">
                {testimonial.quote}
              </blockquote>
              <figcaption class="mt-6 pl-6">
                <span class="label block text-gold">{testimonial.name}</span>
                <span class="editorial mt-1 block text-small text-ivory/55">
                  {testimonial.book}
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Latest journal -->
  {
    latestPosts.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 py-24">
        <div class="reveal flex flex-wrap items-baseline justify-between gap-4">
          <h2 class="text-h2">From the Journal</h2>
          <a href="/journal" class="label group text-burgundy">
            <span class="link-sweep">All articles</span>
            <span class="nudge ml-1" aria-hidden="true">
              &rarr;
            </span>
          </a>
        </div>

        <ul class="mt-14 grid gap-12 md:grid-cols-3">
          {latestPosts.map((post, i) => (
            <li class="reveal" style={`--reveal-delay:${i}`}>
              <a href={`/journal/${post.id}`} class="group block">
                <p class="metadata text-label uppercase tracking-wider text-charcoal/50">
                  <span class="text-rule-gold">{post.data.category}</span>
                  <span aria-hidden="true" class="mx-2 opacity-40">
                    /
                  </span>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                </p>
                <h3 class="mt-3 text-h4 transition-colors group-hover:text-burgundy/70">
                  {post.data.title}
                </h3>
                <p class="editorial mt-3 text-charcoal/75">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Closing CTA -->
  <section class="grained bg-burgundy text-ivory">
    <div class="mx-auto max-w-3xl px-6 py-28 text-center">
      <div class="reveal">
        <h2 class="text-h2 text-ivory">Tell us about your book.</h2>
        <Ornament tone="dark" class="mx-auto mt-8" />
        <p class="editorial mt-8 text-ivory/75">
          An editor reads every inquiry — properly, not as a queue — and replies
          within two business days. There is no charge and no obligation.
        </p>
        <a
          href="/inquiry"
          class="label lift mt-10 inline-block bg-gold px-10 py-4 text-burgundy hover:bg-ivory"
        >
          Start Your Book
        </a>
      </div>
    </div>
  </section>
</Base>
