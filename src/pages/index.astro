---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Ornament from '~/components/Ornament.astro';
import Bestsellers from '~/components/Bestsellers.astro';
import heroSpines from '~/assets/generated/hero-spines2.png';
import book1 from '~/assets/generated/book_1.png';
import book2 from '~/assets/generated/book_2.png';
import book3 from '~/assets/generated/book_3.png';
import book4 from '~/assets/generated/book_4.png';
import book5 from '~/assets/generated/book_5.png';
import book6 from '~/assets/generated/book_6.png';
import book7 from '~/assets/generated/book_7.png';
import book8 from '~/assets/generated/book_8.png';
import book9 from '~/assets/generated/book_9.png';
import book10 from '~/assets/generated/book_10.png';

const allBooks = [book1, book2, book3, book4, book5, book6, book7, book8, book9, book10];
import { getBooks } from '~/lib/content';
import {
  SERVICES,
  ADDITIONAL_SERVICES,
  GENRE_GROUPS,
  PROCESS_STEPS,
  TESTIMONIALS,
  FAQS,
  RETAILERS,
  HERO_PROMISES,
  STATS,
} from '~/data/site';

const books = await getBooks();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<Base
  title="home"
  description="Ghostwriting, editing, cover design, publishing and marketing. TOME turns a manuscript, an outline or a half-formed idea into a book that exists — published under your own name."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- 1. Hero -->
  <section class="grained relative overflow-hidden bg-burgundy text-ivory">
    <div
      class="mx-auto grid max-w-7xl gap-16 px-6 py-24 md:py-32 lg:grid-cols-[1.1fr_0.9fr] lg:items-center"
    >
      <div class="reveal">
        <p class="label text-gold">Ghostwriting &middot; Editing &middot; Publishing</p>
        <Ornament tone="dark" class="mt-5 !w-[120px] !justify-start" />

        <h1 class="mt-8 text-ivory">
          Unlock your imagination with <span class="text-gold">TOME</span>
        </h1>

        <p class="mt-8 max-w-xl text-ivory/75">
          We give writers a place to turn a manuscript, an outline, or a half-formed
          idea into a book that exists in the world — edited properly, designed
          properly, and published under your own name.
        </p>

        <div class="mt-10 border-l-2 border-rule-gold pl-6">
          <p class="label mb-4 text-gold">Here&rsquo;s what&rsquo;s in store</p>
          <ul class="editorial space-y-2.5 text-ivory/85">
            {
              HERO_PROMISES.map((promise) => (
                <li class="flex items-start gap-3">
                  <span aria-hidden="true" class="mt-2 block h-1.5 w-1.5 rotate-45 bg-gold" />
                  {promise}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-12 flex flex-wrap items-center gap-4">
          <a href="/inquiry" class="label lift bg-gold px-8 py-4 text-burgundy hover:bg-ivory">
            Get Started
          </a>
          <a
            href="#services"
            class="label lift border border-rule-gold px-8 py-4 text-gold hover:bg-rule-gold/10"
          >
            See our services
          </a>
        </div>

        <p class="metadata mt-8 text-small text-ivory/55">
          <span aria-hidden="true" class="mr-2 text-gold">&#9670;</span>
          Authors keep 100% of royalties
        </p>
      </div>

      <div class="reveal hidden lg:block" style="--reveal-delay:2">
        <div id="bookshelf-container" class="relative w-[92%] scale-125 mx-auto transition-transform">
          <Image
            src={heroSpines}
            alt="An empty wooden bookshelf"
            widths={[440, 660, 900]}
            sizes="(max-width: 1024px) 0px, 440px"
            class="w-full h-auto drop-shadow-2xl"
            loading="eager"
          />
          <button id="shake-btn" class="absolute top-[80.5%] left-[16.5%] w-[67%] h-[11%] z-30 flex items-center justify-center text-gold font-bold uppercase tracking-widest text-2xl cursor-pointer hover:bg-gold/10 transition-colors rounded-sm shadow-inner" style="text-shadow: 0 2px 4px rgba(0,0,0,0.8);" title="Shake Bookshelf!">Shake me</button>
          
          <!-- Shelf 1 (Top) -->
          <div class="draggable-shelf absolute top-[21.5%] left-[16.4%] w-[67.5%] h-[11%] flex items-end justify-center gap-0">
            {Array.from({ length: 17 }).map((_, i) => (
              <Image
                src={allBooks[(i * 7 + 1) % 10]}
                alt="Book spine"
                class="draggable-book w-[5.1%] shrink-0 transition-all duration-300 hover:-translate-y-3 drop-shadow-sm hover:drop-shadow-xl cursor-grab active:cursor-grabbing rounded-sm transform-gpu will-change-transform"
                style={`height: ${75 + (i % 4) * 6}%;`}
                data-original-height={`${75 + (i % 4) * 6}%`}
                draggable="true"
              />
            ))}
          </div>

          <!-- Shelf 2 -->
          <div class="draggable-shelf absolute top-[36.3%] left-[16.4%] w-[67.5%] h-[11%] flex items-end justify-center gap-0">
            {Array.from({ length: 17 }).map((_, i) => (
              <Image
                src={allBooks[(i * 3 + 4) % 10]}
                alt="Book spine"
                class="draggable-book w-[5.1%] shrink-0 transition-all duration-300 hover:-translate-y-3 drop-shadow-sm hover:drop-shadow-xl cursor-grab active:cursor-grabbing rounded-sm transform-gpu will-change-transform"
                style={`height: ${75 + ((i+1) % 4) * 6}%;`}
                data-original-height={`${75 + ((i+1) % 4) * 6}%`}
                draggable="true"
              />
            ))}
          </div>

          <!-- Shelf 3 -->
          <div class="draggable-shelf absolute top-[50.7%] left-[16.4%] w-[67.5%] h-[11%] flex items-end justify-center gap-0">
            {Array.from({ length: 17 }).map((_, i) => (
              <Image
                src={allBooks[(i * 9 + 2) % 10]}
                alt="Book spine"
                class="draggable-book w-[5.1%] shrink-0 transition-all duration-300 hover:-translate-y-3 drop-shadow-sm hover:drop-shadow-xl cursor-grab active:cursor-grabbing rounded-sm transform-gpu will-change-transform"
                style={`height: ${75 + ((i+2) % 4) * 6}%;`}
                data-original-height={`${75 + ((i+2) % 4) * 6}%`}
                draggable="true"
              />
            ))}
          </div>

          <!-- Shelf 4 (Bottom) -->
          <div class="draggable-shelf absolute top-[65.2%] left-[16.4%] w-[67.5%] h-[11%] flex items-end justify-center gap-0">
            {Array.from({ length: 17 }).map((_, i) => (
              <Image
                src={allBooks[(i * 11 + 5) % 10]}
                alt="Book spine"
                class="draggable-book w-[5.1%] shrink-0 transition-all duration-300 hover:-translate-y-3 drop-shadow-sm hover:drop-shadow-xl cursor-grab active:cursor-grabbing rounded-sm transform-gpu will-change-transform"
                style={`height: ${75 + ((i+3) % 4) * 6}%;`}
                data-original-height={`${75 + ((i+3) % 4) * 6}%`}
                draggable="true"
              />
            ))}
          </div>
          <!-- Floor Area -->
          <div id="book-floor" class="draggable-floor absolute top-[75%] left-[16.4%] w-[67.5%] h-[23%] z-50 opacity-0 pointer-events-none transition-opacity duration-1000">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who we are -->
  <section class="bg-charcoal/[0.03]">
    <div class="mx-auto max-w-4xl px-6 py-24">
      <div class="reveal">
        <p class="label text-burgundy/70">Who We Are</p>
        <h2 class="mt-5 text-h2">Expert book writers, to bring your literary vision to life</h2>
      </div>

      <div class="reveal editorial mt-10 space-y-6 text-charcoal/80" style="--reveal-delay:1">
        <p>
          TOME exists because too many good manuscripts die in a drawer between
          finishing and publishing. That gap is full of technical work — editing,
          typesetting, ISBNs, metadata, distribution — and none of it is why you
          started writing.
        </p>
        <p>
          We handle that part. Your ideas stay yours: we safeguard the creative
          integrity of the work while doing the unglamorous production that stands
          between a draft and a book on a shelf.
        </p>
        <p class="text-h4 italic text-burgundy">
          You wrote the book. We do the part that stands between the draft and the
          shelf — and when it goes on sale, your name is the only one on the cover.
        </p>
      </div>

      <div class="reveal mt-10 flex flex-wrap gap-4">
        <a
          href="/inquiry"
          class="label lift bg-burgundy px-8 py-4 text-ivory hover:bg-burgundy/90"
        >
          Get Started
        </a>
        <a
          href="/about"
          class="label lift border border-burgundy px-8 py-4 text-burgundy hover:bg-burgundy hover:text-ivory"
        >
          More about us
        </a>
      </div>
    </div>
  </section>

  <!-- 3. Stats -->
  <section class="grained bg-charcoal text-ivory">
    <div class="mx-auto max-w-5xl px-6 py-20 text-center">
      <div class="reveal">
        <p class="label text-gold">By the Numbers</p>
        <h2 class="mt-4 text-h3 text-ivory">A team that has done this before</h2>
        <p class="editorial mx-auto mt-5 max-w-xl text-ivory/70">
          Editors, designers and production staff who work on books full time — not a
          marketplace of freelancers assembled per project.
        </p>
      </div>

      <dl class="mt-14 grid grid-cols-1 gap-12 sm:grid-cols-3">
        {
          STATS.map((stat, i) => (
            <div class="reveal flex flex-col-reverse gap-3" style={`--reveal-delay:${i}`}>
              <dt class="label text-ivory/60">{stat.label}</dt>
              <dd class="metadata text-h2 leading-none text-gold">
                {stat.figure}
                {stat.suffix}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 4. Services -->
  <section id="services" class="mx-auto max-w-7xl px-6 py-24">
    <div class="reveal max-w-3xl">
      <p class="label text-burgundy/70">What We Do</p>
      <h2 class="mt-5 text-h2">Join forces with skilled writers to share your story</h2>
      <p class="editorial mt-6 text-charcoal/75">
        Our writing and publishing specialists work on one book at a time, in the
        genres they actually read.
      </p>
    </div>

    <ul class="mt-16 grid gap-x-10 gap-y-12 md:grid-cols-2 lg:grid-cols-4">
      {
        SERVICES.map((service, i) => (
          <li class="reveal" style={`--reveal-delay:${i % 4}`}>
            <article class="group flex h-full flex-col border-t border-rule-warm/80 pt-6">
              <h3 class="text-h4">{service.title}</h3>
              <p class="editorial mt-4 flex-1 text-charcoal/75">{service.summary}</p>
              <p class="label mt-6 text-burgundy">
                <a href={`/services/${service.slug}`} class="link-sweep inline-block py-2">
                  Explore
                </a>
                <span aria-hidden="true" class="nudge ml-1">
                  &rarr;
                </span>
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 5. CTA band -->
  <section class="grained bg-burgundy text-ivory">
    <div class="reveal mx-auto max-w-3xl px-6 py-20 text-center">
      <h2 class="text-h2 text-ivory">Are you ready to become a published author?</h2>
      <Ornament tone="dark" class="mx-auto mt-8" />
      <p class="editorial mt-8 text-ivory/75">
        TOME is your route to a book that exists — properly made, and entirely yours.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/inquiry" class="label lift bg-gold px-8 py-4 text-burgundy hover:bg-ivory">
          Get Started
        </a>
        <a
          href="mailto:hello@tomepublishers.com"
          class="label lift border border-rule-gold px-8 py-4 text-gold hover:bg-rule-gold/10"
        >
          Email us
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Genres -->
  <section class="mx-auto max-w-7xl px-6 py-24">
    <div class="reveal max-w-3xl">
      <p class="label text-burgundy/70">What We Take On</p>
      <h2 class="mt-5 text-h2">Genres our editors actually read</h2>
      <p class="editorial mt-6 text-charcoal/75">
        We match every book to someone who knows the shelf it belongs on — the
        conventions, the comparable titles and the readers who buy them.
      </p>
    </div>

    <div class="mt-16 space-y-14">
      {
        GENRE_GROUPS.map((group) => (
          <div class="reveal">
            <h3 class="label border-b border-rule-warm pb-3 text-burgundy">{group.heading}</h3>
            <dl class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
              {group.items.map(([term, detail]) => (
                <div>
                  <dt class="editorial text-h4 text-burgundy">{term}</dt>
                  <dd class="editorial mt-2 text-charcoal/70">{detail}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 7. Additional services -->
  <section class="bg-charcoal/[0.03]">
    <div class="mx-auto max-w-7xl px-6 py-24">
      <div class="reveal max-w-2xl">
        <p class="label text-burgundy/70">And Also</p>
        <h2 class="mt-5 text-h2">Unlock your book&rsquo;s full potential</h2>
        <p class="editorial mt-6 text-charcoal/75">
          The work that continues after publication day.
        </p>
      </div>

      <ul class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          ADDITIONAL_SERVICES.map((service, i) => (
            <li class="reveal" style={`--reveal-delay:${i % 4}`}>
              <a
                href={`/services/${service.slug}`}
                class="lift group block h-full border border-rule-gold/80 bg-ivory p-7"
              >
                <h3 class="text-h4 transition-colors group-hover:text-burgundy/70">
                  {service.title}
                </h3>
                <p class="editorial mt-3 text-charcoal/70">{service.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 8. Bestsellers -->
  <section class="mx-auto max-w-7xl px-6 py-24">
    <div class="reveal max-w-2xl">
      <p class="label text-burgundy/70">Our Shelf</p>
      <h2 class="mt-5 text-h2">Look at our bestsellers</h2>
      <p class="editorial mt-6 text-charcoal/75">
        A sample of the books our authors have published.
      </p>
    </div>

    <div class="mt-14">
      <Bestsellers books={books} />
    </div>
  </section>

  <!-- 9. Distribution -->
  <section class="grained overflow-hidden bg-charcoal text-ivory">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="reveal text-center">
        <p class="label text-gold">Distribution</p>
        <h2 class="mt-4 text-h3 text-ivory">Sell your book with</h2>
      </div>

      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-5">
        {
          RETAILERS.map((retailer) => (
            <li class="editorial text-h4 text-ivory/45 transition-colors hover:text-gold">
              {retailer}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 10. Process -->
  <section class="mx-auto max-w-5xl px-6 py-24">
    <div class="reveal max-w-2xl">
      <p class="label text-burgundy/70">How It Works</p>
      <h2 class="mt-5 text-h2">The meticulous approach of TOME</h2>
      <p class="editorial mt-6 text-charcoal/75">
        Six stages, every one of them visible to you.
      </p>
    </div>

    <ol class="mt-16 grid gap-x-12 gap-y-12 sm:grid-cols-2">
      {
        PROCESS_STEPS.map((step, i) => (
          <li class="reveal border-t border-rule-warm/80 pt-6" style={`--reveal-delay:${i % 2}`}>
            <p class="metadata text-label uppercase tracking-widest text-burgundy/70">
              Step {step.n}
            </p>
            <h3 class="mt-3 text-h4">{step.title}</h3>
            <p class="editorial mt-3 text-charcoal/75">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-14">
      <a
        href="/process"
        class="label lift inline-block border border-burgundy px-8 py-4 text-burgundy hover:bg-burgundy hover:text-ivory"
      >
        The Full Process
      </a>
    </div>
  </section>

  <!-- 11. Testimonials -->
  <section class="grained bg-burgundy text-ivory">
    <div class="mx-auto max-w-7xl px-6 py-24">
      <div class="reveal text-center">
        <p class="label text-gold">Testimonials</p>
        <h2 class="mt-4 text-h2 text-ivory">What our authors say</h2>
        <Ornament tone="dark" class="mx-auto mt-8" />
      </div>

      <ul class="mt-16 grid gap-x-10 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
        {
          TESTIMONIALS.map((testimonial, i) => (
            <li class="reveal" style={`--reveal-delay:${i % 3}`}>
              <figure class="h-full border-l-2 border-rule-gold pl-6">
                <blockquote class="editorial text-ivory/90">
                  &ldquo;{testimonial.quote}&rdquo;
                </blockquote>
                <figcaption class="mt-5">
                  <span class="label block text-gold">{testimonial.name}</span>
                  <span class="editorial mt-1 block text-small text-ivory/55">
                    {testimonial.role}
                  </span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 12. FAQ -->
  <section class="mx-auto max-w-3xl px-6 py-24">
    <div class="reveal">
      <p class="label text-burgundy/70">Answers</p>
      <h2 class="mt-5 text-h2">Frequently asked questions</h2>
    </div>

    <div class="reveal mt-12">
      {
        FAQS.map((faq) => (
          <details class="group border-b border-charcoal/10 py-5">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 [&::-webkit-details-marker]:hidden">
              <span class="editorial text-h4 text-burgundy">{faq.q}</span>
              <span
                aria-hidden="true"
                class="mt-1.5 shrink-0 text-burgundy/60 transition-transform group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="editorial mt-4 pr-10 text-charcoal/80">{faq.a}</p>
          </details>
        ))
      }
    </div>

    <p class="reveal mt-10 text-center">
      <a href="/faq" class="label inline-block px-4 py-3 text-burgundy">
        <span class="link-sweep">All questions</span>
      </a>
    </p>
  </section>

  <!-- 13. Closing CTA -->
  <section class="grained bg-burgundy text-ivory">
    <div class="reveal mx-auto max-w-3xl px-6 py-24 text-center">
      <h2 class="text-h2 text-ivory">Tell your story to the world</h2>
      <Ornament tone="dark" class="mx-auto mt-8" />
      <p class="editorial mt-8 text-ivory/75">
        Leave us three details and we will come back with an honest read on your
        book — scope, timeline and cost, before you commit to anything.
      </p>
      <a href="/inquiry" class="label lift mt-10 inline-block bg-gold px-10 py-4 text-burgundy hover:bg-ivory">
        Let&rsquo;s start
      </a>
      <p class="metadata mt-6 text-small text-ivory/50">
        No obligation, and no sales call unless you ask for one. We reply within one
        business day.
      </p>
    </div>
  </section>

  <script>
    function setupDragAndDrop() {
      const books = document.querySelectorAll('.draggable-book');
      
      let draggedBook = null;
      let clone = null;
      let offsetX = 0;
      let offsetY = 0;

      books.forEach(book => {
        // Disable native drag just in case
        book.removeAttribute('draggable');
        
        // Use pointerdown to start custom drag
        book.addEventListener('pointerdown', (e) => {
          if (e.button !== 0) return; // Only left click
          if (draggedBook) return; // Only one book at a time
          
          // Ensure only the top book under the cursor is pickable
          const elementsUnderCursor = document.elementsFromPoint(e.clientX, e.clientY);
          const topBook = elementsUnderCursor.find(el => el.classList && el.classList.contains('draggable-book'));
          if (topBook && topBook !== book) return; // Ignore if there's a book above this one

          e.preventDefault(); // prevent native drag or text selection
          
          draggedBook = book;
          
          const rect = book.getBoundingClientRect();
          offsetX = e.clientX - rect.left;
          offsetY = e.clientY - rect.top;
          
          clone = book.cloneNode(true);
          clone.style.position = 'fixed';
          clone.style.zIndex = '9999';
          clone.style.pointerEvents = 'none'; // Pass through clicks
          if (book.classList.contains('on-floor')) {
            clone.style.height = (book.offsetHeight * 1.25) + 'px';
            clone.style.width = (book.offsetWidth * 1.25) + 'px';
          } else {
            clone.style.width = rect.width + 'px';
            clone.style.height = rect.height + 'px';
          }
          clone.style.left = rect.left + 'px';
          clone.style.top = rect.top + 'px';
          clone.style.transition = 'transform 0.2s cubic-bezier(0.2, 0, 0, 1)';
          clone.style.margin = '0';
          clone.style.opacity = '1';
          requestAnimationFrame(() => {
            if (clone) clone.style.transform = 'scale(1.05)';
          });
          clone.classList.remove('hover:-translate-y-3', 'hover:drop-shadow-xl', 'cursor-grab', 'active:cursor-grabbing');
          
          document.body.appendChild(clone);
          
          // Make original blank
          book.style.opacity = '0';
          
          document.addEventListener('pointermove', onPointerMove);
          document.addEventListener('pointerup', onPointerUp);
        });
      });
      
      function onPointerMove(e) {
        if (!clone) return;
        clone.style.left = (e.clientX - offsetX) + 'px';
        clone.style.top = (e.clientY - offsetY) + 'px';
      }
      
      function onPointerUp(e) {
        if (!draggedBook) return;
        
        document.removeEventListener('pointermove', onPointerMove);
        document.removeEventListener('pointerup', onPointerUp);
        
        let target = document.elementFromPoint(e.clientX, e.clientY);
        if (target && !target.classList.contains('draggable-book') && !target.classList.contains('draggable-shelf') && !target.classList.contains('draggable-floor')) {
           target = target.closest('.draggable-book, .draggable-shelf, .draggable-floor');
        }
        
        let isTargetFullShelf = false;
        if (target) {
          const shelfTarget = target.classList.contains('draggable-shelf') ? target : target.closest('.draggable-shelf');
          if (shelfTarget && shelfTarget.querySelectorAll('.draggable-book').length >= 17) {
            isTargetFullShelf = true;
          }
        }
        
        // Magnetic snap to the closest available shelf
        if (!target || isTargetFullShelf || (target.classList && target.classList.contains('draggable-floor')) || (target.closest && target.closest('#book-floor'))) {
           const shelves = document.querySelectorAll('.draggable-shelf');
           let closestShelf = null;
           let minDistance = 150;
           
           for (const shelf of shelves) {
             if (shelf.querySelectorAll('.draggable-book').length >= 17) continue; // Skip full shelves
             
             const rect = shelf.getBoundingClientRect();
             const dx = Math.max(rect.left - e.clientX, 0, e.clientX - rect.right);
             const dy = Math.max(rect.top - e.clientY, 0, e.clientY - rect.bottom);
             const dist = Math.sqrt(dx*dx + dy*dy);
             
             if (dist < minDistance) {
               minDistance = dist;
               closestShelf = shelf;
             }
           }
           
           if (closestShelf) {
             target = closestShelf;
           }
        }
        
        const floorContainer = document.getElementById('book-floor');
        
        if (target) {
          if (target.classList.contains('draggable-book') && target !== draggedBook) {
            const targetInShelf = target.closest('.draggable-shelf');
            if (targetInShelf) {
              const draggedWasOnFloor = draggedBook.closest('.draggable-floor');
              const draggedLeft = draggedBook.style.left;
              const draggedTop = draggedBook.style.top;
              const draggedTransform = draggedBook.style.transform;
              
              // Swap
              const draggedNextSibling = draggedBook.nextSibling;
              const draggedParent = draggedBook.parentNode;
              const targetNextSibling = target.nextSibling;
              const targetParent = target.parentNode;
              
              if (draggedNextSibling) draggedParent.insertBefore(target, draggedNextSibling);
              else draggedParent.appendChild(target);
              
              if (targetNextSibling) targetParent.insertBefore(draggedBook, targetNextSibling);
              else targetParent.appendChild(draggedBook);
              
              // Reset draggedBook styles to fit in shelf
              draggedBook.classList.remove('on-floor');
              draggedBook.style.position = '';
              draggedBook.style.left = '';
              draggedBook.style.top = '';
              draggedBook.style.transform = 'none';
              draggedBook.style.height = draggedBook.dataset.originalHeight;
              draggedBook.style.width = '';
              
              if (draggedWasOnFloor) {
                target.classList.add('on-floor');
                target.style.position = 'absolute';
                target.style.left = draggedLeft;
                target.style.top = draggedTop;
                target.style.transform = draggedTransform;
                target.style.height = '100px';
                target.style.width = 'auto';
              } else {
                target.classList.remove('on-floor');
              }
            } else {
              // Target is on floor, just place draggedBook on floor
              floorContainer.appendChild(draggedBook);
              const floorRect = floorContainer.getBoundingClientRect();
              draggedBook.style.position = 'absolute';
              draggedBook.style.left = (e.clientX - floorRect.left - offsetX) + 'px';
              draggedBook.style.top = (e.clientY - floorRect.top - offsetY) + 'px';
              draggedBook.classList.add('on-floor');
              draggedBook.style.height = '110px';
              draggedBook.style.width = 'auto';
              const rotZ = (Math.random() - 0.5) * 120;
              draggedBook.style.transform = `rotate(${rotZ}deg) scale(0.9)`;
            }
          } else if (target.classList.contains('draggable-shelf')) {
            if (target.querySelectorAll('.draggable-book').length < 17) {
              target.appendChild(draggedBook);
              draggedBook.classList.remove('on-floor');
              draggedBook.style.position = '';
              draggedBook.style.left = '';
              draggedBook.style.top = '';
              draggedBook.style.transform = 'none';
              draggedBook.style.height = draggedBook.dataset.originalHeight;
              draggedBook.style.width = '';
            }
          } else if (target.classList.contains('draggable-floor') || target.closest('#book-floor')) {
            floorContainer.appendChild(draggedBook);
            const floorRect = floorContainer.getBoundingClientRect();
            draggedBook.style.position = 'absolute';
            draggedBook.style.left = (e.clientX - floorRect.left - offsetX) + 'px';
            draggedBook.style.top = (e.clientY - floorRect.top - offsetY) + 'px';
            draggedBook.classList.add('on-floor');
            draggedBook.style.height = '110px';
            draggedBook.style.width = 'auto';
            const rotZ = (Math.random() - 0.5) * 120;
            draggedBook.style.transform = `rotate(${rotZ}deg) scale(0.9)`;
          }
        }
        
        const currentDragged = draggedBook;
        const currentClone = clone;
        
        if (currentClone) {
          const finalRect = currentDragged.getBoundingClientRect();
          currentClone.style.transition = 'all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
          currentClone.style.left = finalRect.left + 'px';
          currentClone.style.top = finalRect.top + 'px';
          currentClone.style.width = finalRect.width + 'px';
          currentClone.style.height = finalRect.height + 'px';
          currentClone.style.transform = currentDragged.style.transform && currentDragged.style.transform !== 'none' ? currentDragged.style.transform : 'scale(1)';
          
          setTimeout(() => {
            if (currentDragged) currentDragged.style.opacity = '1';
            if (currentClone) currentClone.remove();
          }, 300);
        } else if (currentDragged) {
          currentDragged.style.opacity = '1';
        }
        
        draggedBook = null;
        clone = null;
      }
      
      const shakeBtn = document.getElementById('shake-btn');
      const bookshelf = document.getElementById('bookshelf-container');
      const floor = document.getElementById('book-floor');
      
      if (shakeBtn) {
        shakeBtn.addEventListener('click', () => {
          if (!bookshelf) return;
          
          const allBooksOnShelves = document.querySelectorAll('.draggable-shelf .draggable-book');
          if (allBooksOnShelves.length === 0) return;
          
          bookshelf.style.animation = 'shake 0.4s ease-in-out infinite';
          
          setTimeout(() => {
            bookshelf.style.animation = 'none';
            floor.classList.remove('opacity-0', 'pointer-events-none');
            floor.classList.add('opacity-100');
            
            // FLIP animation
            const firstRects = new Map();
            allBooksOnShelves.forEach(b => {
              firstRects.set(b, b.getBoundingClientRect());
            });
            
            allBooksOnShelves.forEach(b => {
              floor.appendChild(b);
              b.style.position = 'absolute';
              
              let r = (Math.random() + Math.random() + Math.random()) / 3; 
              const randomLeft = r * 85; 
              
              const distFromCenter = Math.abs(50 - randomLeft); 
              const minTop = distFromCenter * 1.5; 
              let randomTop = minTop + Math.random() * (75 - minTop);
              if (randomTop > 75) randomTop = 75;
              
              const rotZ = (Math.random() - 0.5) * 140; 
              
              b.style.left = `${randomLeft}%`;
              b.style.top = `${randomTop}%`;
              b.style.height = '110px';
              b.style.width = 'auto';
              b.style.margin = '0';
              b.style.zIndex = Math.floor(Math.random() * 100);
              b.dataset.finalTransform = `rotate(${rotZ}deg) scale(0.9)`;
            });
            
            requestAnimationFrame(() => {
              allBooksOnShelves.forEach(b => {
                const lastRect = b.getBoundingClientRect();
                const firstRect = firstRects.get(b);
                const deltaX = firstRect.left - lastRect.left;
                const deltaY = firstRect.top - lastRect.top;
                
                b.style.transition = 'none';
                b.style.transform = `translate(${deltaX}px, ${deltaY}px) rotate(0deg)`;
              });
              
              requestAnimationFrame(() => {
                allBooksOnShelves.forEach((b, i) => {
                  setTimeout(() => {
                    b.classList.add('on-floor');
                    b.style.transition = 'transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
                    b.style.transform = b.dataset.finalTransform;
                  }, Math.random() * 800);
                });
              });
            });
            
          }, 800);
        });
      }
    }

    document.addEventListener('astro:page-load', setupDragAndDrop);
    setupDragAndDrop();
  </script>

  <style is:global>
    @keyframes shake {
      0% { transform: translate(1px, 1px) rotate(0deg); }
      10% { transform: translate(-1px, -2px) rotate(-1deg); }
      20% { transform: translate(-3px, 0px) rotate(1deg); }
      30% { transform: translate(3px, 2px) rotate(0deg); }
      40% { transform: translate(1px, -1px) rotate(1deg); }
      50% { transform: translate(-1px, 2px) rotate(-1deg); }
      60% { transform: translate(-3px, 1px) rotate(0deg); }
      70% { transform: translate(3px, 1px) rotate(-1deg); }
      80% { transform: translate(-1px, -1px) rotate(1deg); }
      90% { transform: translate(1px, 2px) rotate(0deg); }
      100% { transform: translate(1px, -2px) rotate(-1deg); }
    }
    .draggable-book.on-floor {
      filter: drop-shadow(2px 4px 6px rgba(0,0,0,0.4));
    }
  </style>
</Base>
