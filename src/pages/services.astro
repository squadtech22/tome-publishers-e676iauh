---
import Base from '~/layouts/Base.astro';
import Ornament from '~/components/Ornament.astro';
import { SERVICES, SPECIALIST_SERVICES, ADDITIONAL_SERVICES } from '~/data/site';

const groups = [
  { heading: 'Writing, editing and publishing', items: SERVICES },
  { heading: 'Genres and packages', items: SPECIALIST_SERVICES },
  { heading: 'After publication day', items: ADDITIONAL_SERVICES },
];
---

<Base
  title="Services"
  description="Ghostwriting, editing, cover design, formatting, publishing, marketing and audiobooks — everything TOME does for authors, in one place."
>
  <section class="grained bg-burgundy text-ivory">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <p class="label text-rule-gold mb-5">What We Do</p>
      <h1 class="max-w-3xl text-ivory">Everything between the draft and the shelf</h1>
      <Ornament tone="dark" class="mt-8 !w-[120px] !justify-start" />
      <p class="editorial mt-8 max-w-2xl text-h4 text-ivory/80">
        Twelve services, scoped individually. Almost nobody needs all of them —
        the conversation starts with which parts your book actually requires.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 py-20">
    {
      groups.map((group) => (
        <section class="mb-20 last:mb-0">
          <h2 class="reveal label border-b border-rule-gold pb-3 text-burgundy">
            {group.heading}
          </h2>

          <ul class="mt-10 grid gap-x-12 gap-y-12 md:grid-cols-2">
            {group.items.map((service, i) => (
              <li class="reveal" style={`--reveal-delay:${i % 2}`}>
                <article class="group flex h-full flex-col">
                  <h3 class="text-h3">
                    <a
                      href={`/services/${service.slug}`}
                      class="transition-colors hover:text-burgundy/70"
                    >
                      {service.title}
                    </a>
                  </h3>
                  <p class="editorial mt-4 flex-1 text-charcoal/75">{service.summary}</p>
                  <p class="label mt-5 text-burgundy">
                    <a href={`/services/${service.slug}`} class="link-sweep">
                      Explore
                    </a>
                    <span aria-hidden="true" class="nudge ml-1">
                      &rarr;
                    </span>
                  </p>
                </article>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <section class="grained bg-burgundy text-ivory">
    <div class="reveal mx-auto max-w-3xl px-6 py-24 text-center">
      <h2 class="text-h2 text-ivory">Not sure which parts you need?</h2>
      <Ornament tone="dark" class="mx-auto mt-8" />
      <p class="editorial mt-8 text-ivory/75">
        Neither are most authors at this stage. Tell us where the manuscript stands
        and we will tell you honestly what it does and does not require.
      </p>
      <a
        href="/inquiry"
        class="label lift mt-10 inline-block bg-gold px-10 py-4 text-burgundy hover:bg-ivory"
      >
        Get Started
      </a>
    </div>
  </section>
</Base>
